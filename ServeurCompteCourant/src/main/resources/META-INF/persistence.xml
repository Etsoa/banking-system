<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="http://jakarta.ee/xml/ns/persistence" version="3.0">
    <persistence-unit name="CompteCourantPU" transaction-type="JTA">
        <provider>org.hibernate.jpa.HibernateJpaProvider</provider>
        <jta-data-source>java:jboss/datasources/PostgresDS</jta-data-source>
        <class>com.example.comptecourant.models.CompteCourant</class>
        <class>com.example.comptecourant.models.Transaction</class>
        <class>com.example.comptecourant.models.Utilisateur</class>
        <class>com.example.comptecourant.models.Direction</class>
        <class>com.example.comptecourant.models.ActionRole</class>
        <properties>
            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQL10Dialect"/>
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.show_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
